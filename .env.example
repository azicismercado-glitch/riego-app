# --- Base de datos ---
DATABASE_URL=postgres://riego:riego@localhost:5432/riego

# --- Autenticación ---
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000

# --- SMTP (envío real de correos) ---
# Completar antes de producción. Mientras estén vacíos, los correos quedan
# guardados en la tabla "emails" con estado "logged" pero no se envían de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diagnóstico Técnico de Riego <no-reply@example.org>"
