# --- Base de datos ---
DATABASE_URL=postgres://riego:riego@localhost:5432/riego

# --- Autenticación ---
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000

# --- SMTP (envío real de correos) ---
# Completar antes de producción. Mientras estén vacíos, los correos quedan
# guardados en la tabla "emails" con estado "logged" pero no se envían de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diagnóstico Técnico de Riego <no-reply@example.org>"

# --- Rutas de administración (/api/admin/*) ---
# Clave compartida que protege las rutas de operación (migrar, crear usuarios,
# asignar provincias). Definirla como variable de entorno del servicio; no
# commitear el valor real. Sin esta variable las rutas responden error.
ADMIN_SETUP_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
